# =================================
# SUPABASE CONFIGURATION
# =================================
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =================================
# AI SERVICES
# =================================
VITE_GROQ_API_KEY=your_groq_api_key

# =================================
# PAYSTACK PAYMENT GATEWAY
# =================================
# IMPORTANT: Frontend variables MUST start with VITE_ in Vite
# NEVER expose secret keys in frontend code
# Secret keys should only exist on backend/server

# Test Mode Public Key (for development/testing)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_6ebf90bf3f248cdaa0010fc0e515ee85ef59a52c

# Live Mode Public Key (for production)
# Uncomment and replace with your live key when going to production
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_845bdc92fbb5c135adf2d6060599dcbe9460685f

# =================================
# GOOGLE OAUTH
# =================================
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# =================================
# ADMIN CONFIGURATION
# =================================
# Comma-separated emails that can open /admin (UI gate)
# Pair with DB role + RLS: supabase/migrations/001_admin_rls.sql
VITE_ADMIN_EMAILS=you@example.com

# =================================
# STRIPE (Legacy - Keep for reference)
# =================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51QbqdoHPD8pnlRZIRt3pboMv7kcuAreJt1gdhqtRywOYS5D4nW41YeyfSCl7n3yumyEoRRL6SIQMjBBABzx2dJvW007Rsa3uDf

# Optional server-only copy for Vercel (same value as VITE_GROQ_API_KEY). Keeps Groq off the client if you remove VITE_ from the browser later.
# GROQ_API_KEY=

# Syllabus web layer: Tavily search + scrape text → Groq extraction (POST /api/v1/syllabus/web). Works on Vite dev and Vercel serverless.
TAVILY_API_KEY=

VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Comma-separated emails that can open /admin (UI gate). Pair with DB role + RLS: supabase/migrations/001_admin_rls.sql
VITE_ADMIN_EMAILS=you@example.com
